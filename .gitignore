# Test sources and test config. 只留在本地，不入远程仓库 —— 远程仓库只保留
# 部署运行所需的文件集合加 README。此前测试源码是入库的（配 .github/workflows 跑
# npm test），现在整条链路一起移出：测试源码、jest.config.js、CI workflow。
# 代价是干净检出后 npm test 不可用（jest 找不到用例），本地开发不受影响。
tests/
**/__tests__/
jest.config.js
.github/

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
backstop_data/

# Documentation (local only; entire folder ignored)
docs/
CHANGELOG.md
CONTRIBUTING.md

# Local maintenance scripts
scripts/

# Database reference and manual migration files
# Runtime migrations are implemented in src/server/db/migrations.js and remain tracked.
src/server/db/schema.sql
src/server/db/migrations/

# Logs and runtime state
*.log
logs/
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches and temporary files
.cache/
.eslintcache
*.tmp
*.temp
*.backup

# Generated exports and reports
outputs/
*.xlsx
*-report.json

# Local archives and backups
_archive/
backups/

# Root-level ad-hoc diagnostics
/test-*.js
/debug-*.js
/check-*.js
/verify-*.js
/diagnose-*.js
/trace-*.js
/deep-*.js
/extract-*.js

# Cloudflare Workers 本地状态（wrangler dev / deploy 生成）
workers/**/.wrangler/
workers/**/node_modules/
workers/**/worker-configuration.d.ts
workers/**/.dev.vars
