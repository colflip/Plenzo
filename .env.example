# ===========================================
# 数据库配置 (Database)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/schedule_db
DB_SSL=true
# DB_CONNECTION_TYPE: 数据库连接方式
#   auto (默认) - 所有环境优先 pg Pool；连接类错误时自动回退 Neon HTTP
#   http/neon   - 强制 Neon HTTP，不创建 pg Pool
#   pool/pg     - 强制 pg Pool，禁用 Neon HTTP 自动回退
DB_CONNECTION_TYPE=auto
# 仅 auto 模式且 DATABASE_URL 指向 neon.tech 时生效
DB_NEON_FALLBACK=true
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10000
DB_FETCH_TIMEOUT=10000
DB_MAX_RETRIES=5
DB_RETRY_DELAY=1000

# 连接熔断：连续 DB_BREAKER_THRESHOLD 次**连接类**错误后，冷却 DB_BREAKER_COOLDOWN 毫秒内
# 请求直接快速失败（503），不再逐个走完重试与指数退避。用于避免数据库宕机时
# 「N 条并发 × 5 次重试 × 15s 退避」把进程和日志一起拖垮。
DB_BREAKER_THRESHOLD=3
DB_BREAKER_COOLDOWN=15000
# 半开：熔断开启 DB_BREAKER_HALF_OPEN 毫秒后放行**一条**探测请求，
# 用于秒级感知「DB 已恢复」（Neon 冷启动/网络抖动），避免白等满整个冷却期。
DB_BREAKER_HALF_OPEN=5000
# 失败计数的时间窗：窗口内无失败则清零，避免偶发抖动被累计成熔断
DB_BREAKER_WINDOW=60000
# 同类告警的日志节流窗口（毫秒），窗口内只打印一次并汇总抑制条数
DB_LOG_THROTTLE_WINDOW=10000
# 启动连通性探测超时（毫秒）；探测失败即跳过迁移并主动熔断
DB_PING_TIMEOUT=10000
# 探测超时后，最多再等多久等底层驱动写出真实原因（避免日志只剩"ping 超时"）
DB_PING_GRACE=6000

# -------------------------------------------
# 本地开发：用 .env.local 覆盖，别改 .env
# -------------------------------------------
# 加载顺序 .env → .env.local（后者覆盖前者，仅非生产环境生效；两者均被 git 忽略）。
# 目的：本机开发指向本地/测试库，避免误连生产 Neon，也避免改动 .env 被误提交。
# 在项目根目录新建 .env.local 写入：
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plenzo_dev
#   DB_SSL=false
# 本地库初始化（Homebrew，PostgreSQL 17）：
#   initdb -D /opt/homebrew/var/postgresql@17 -U postgres --auth=trust
#   pg_ctl -D /opt/homebrew/var/postgresql@17 -l /tmp/pg.log start
#   createdb -h localhost -U postgres plenzo_dev
# 表结构无需手工建：服务启动探测通过后会自动跑幂等迁移。

# ===========================================
# 服务器配置 (Server)
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# JWT 认证 (Authentication)
# ===========================================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# ===========================================
# 安全配置 (Security)
# ===========================================
REQUIRE_STRONG_PASSWORD=true

# CORS 额外允许来源（逗号分隔，需带协议与端口）。
# 内置放行：plenzo.vercel.app / plenzo.onrender.com。
# 非生产环境额外自动放行 localhost 与 127.0.0.1 的任意端口；
# 生产环境不放行任何本机来源（credentials 为 true，避免本机页面/扩展带凭证跨域），
# 因此以 NODE_ENV=production 在本机做冒烟测试时，需在此显式列出运行地址。
# ALLOWED_ORIGINS=https://your-domain.com,http://127.0.0.1:3001

# 速率限制 (Rate Limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ===========================================
# 开发配置 (Development)
# ===========================================
DEBUG_AUDIT=false

# ===========================================
# AI 功能配置 (AI Features)
# ===========================================
# 总开关：启用 AI 助手功能
AI_ENABLED=true

# 当前使用的 AI 模型配置
AI_PROVIDER=mistral                          # 服务商标识
AI_PROTOCOL=openai                           # 协议：openai | messages
AI_API_KEY=your_api_key_here                 # API 密钥
AI_BASE_URL=https://api.mistral.ai/v1        # API 地址
AI_MODEL=mistral-small-latest                # 模型 ID
AI_TIMEOUT=30000                             # 超时时间（毫秒）
AI_MAX_TOKENS=3000                           # 最大生成 tokens

# -------------------------------------------
# 预设模型 1: Mistral AI
# -------------------------------------------
LLM_API_KEY=your_mistral_key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_LABEL=Mistral Small

# ===========================================
# 平台检测 (Platform Detection)
# ===========================================
# 以下变量由部署平台自动设置，无需手动配置
# VERCEL=1
# RENDER=true

# ===========================================
# 令牌纪元 (Token Epoch)
# ===========================================
# JWT 载荷携带 tv=该值；middleware/auth.js 校验不匹配即返回 401「账号信息已变更，请重新登录」。
# 用户改主键(new_id)或批量重编 ID 后 +1，即可让全站在途旧 token 立即失效（旧 id 已指向不存在
# 的用户，否则请求会通过认证却在业务层悄悄查空）。改号完成后记得同步到部署平台的环境变量。
TOKEN_EPOCH=1
